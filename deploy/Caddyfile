{
	default_sni {$PUBLIC_HOST}
	admin off
}

https://{$PUBLIC_HOST} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}
	encode zstd gzip

	# MCP ist nur intern für LibreChat gedacht
	handle /knowledge/mcp* {
		respond 404
	}
	# Wissensspeicher (Memory-Tab, Viewer, Quellenlinks)
	handle_path /knowledge/* {
		reverse_proxy knowledge:8100
	}
	handle {
		reverse_proxy frontend:3080
	}
}
